@{
    ViewData["Title"] = "Home Page";
}

<div class="container-fluid px-4">
                        <h1 class="mt-4">印章貼上PDF</h1>
                        <ol class="breadcrumb mb-4">
                            <li class="breadcrumb-item active">印章貼上</li>
                        </ol>
                        <div class="row">
                            <div class="col-xl-6">
                                <div class="card mb-4">
                                    <div class="card-header">
                                        <i class="fas fa-chart-area me-1"></i>
                                        Area Chart
                                    </div>
                                    <div class="card-body">
                                        <div class="input-group float-right">
                                            <ui>
                                                <div id="Seal1">
                                                    <img border="0" src="~/Seal/Seal1.jpg" width="50">
                                                </div>
                                                <div id="Seal2">                                            
                                                    <img border="0" src="~/Seal/Seal2.jpg" width="50">
                                                </div>
                                            </ui>
                                        </div>
                                    </div>  <!-- <button id="preview" type="submit" class="btn btn-primary float-right">確定</button>-->
                                </div>
                            </div>
                            <div class="col-xl-6">
                                <div class="card mb-4">
                                    <div class="card-header">
                                        <i class="fas fa-chart-bar me-1"></i>
                                        PDFview
                                    </div>
                                    <div class="card-body">
                                        <div id="pdfdivcontent" >
                                            <object data=@Url.Action("PdfOpen","Home") type="application/pdf" width="100%" height="1000px">
                                            </object>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
</div>
 @section Scripts {
    <script>
        $(function () {
            $("#preview").click(function () {
                event.preventDefault();
                window.alert("test");

                $objectTag = $('<object>'); 
                $objectTag.attr("data", "@Url.Action("PdfOpen", "Home")");
                $objectTag.attr("type", "application/pdf");
                $objectTag.attr("width", "100%");
                $objectTag.attr("height", "1000px");
                $("#pdfdivcontent").html("");
                $("#pdfdivcontent").append($objectTag);
            });
        });

        $(function () {
        //Make element draggable
        $(".draggableItem").draggable({
            //  use a helper-clone that is append to 'body' so is not 'contained' by a pane
            helper: function () {
                return $(this).clone().appendTo('body').css({
                    'zIndex': 5
                });
            },
            revert: "invalid",
            cursor: 'move',
            containment: '#pdfdivcontent'
        });
    </script>
}
