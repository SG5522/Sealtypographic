@{
    ViewData["Title"] = "Home Page";
}

<div class="container-fluid px-4">
                        <h1 class="mt-4">印章貼上PDF</h1>
                        <ol class="breadcrumb mb-4">
                            <li class="breadcrumb-item active">印章貼上</li>
                        </ol>
                        <div class="row">
                            <div class="col-xl-6">
                                <div class="card mb-4">
                                    <div class="card-header">
                                        <i class="fas fa-chart-area me-1"></i>
                                        Area Chart
                                    </div>
                                    <div class="card-body">
                                        <div class="input-group float-right">
                                            <ui>
                                                <div id="seal1" draggable="true">
                                                    <img border="0" src="~/Seal/Seal1.jpg" width="50">
                                                </div>
                                                <div id="seal2" draggable="true">                                            
                                                    <img border="0" src="~/Seal/Seal2.jpg" width="50">
                                                </div>
                                            </ui>
                                        </div>
                                    </div>  <!-- <button id="preview" type="submit" class="btn btn-primary float-right">確定</button>-->
                                </div>
                            </div>
                            <div class="col-xl-6">
                                <div class="card mb-4">
                                    <div class="card-header">
                                        <i class="fas fa-chart-bar me-1"></i>
                                        PDFview
                                    </div>
                                    <div class="card-body">
                                        <div class ="droppable" id="pdfdivcontent"  >
                                           <!-- <object data=@Url.Action("PdfOpen","Home") type="application/pdf" width="100%" height="1000px">
                                            </object>
                                           -->
                                           <object data=@Url.Action("PdfOpen","Home") type="image/png" width="100%" height="100%">
                                            </object>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
</div>
 @section Scripts {
    <script>
        $(function () {
            $("#preview").click(function () {
                //Prevent a link from opening the URL:
                //(防止開啟新頁面)
                event.preventDefault();

                $objectTag = $('<object>'); 
                $objectTag.attr("data", "@Url.Action("PdfOpen", "Home")");
                $objectTag.attr("type", "application/pdf");
                $objectTag.attr("width", "100%");
                $objectTag.attr("height", "1000px");
                $("#pdfdivcontent").html("");
                $("#pdfdivcontent").append($objectTag);
            });
        });

        let currentDroppable = null;

        seal1.onmousedown = function(event) {

          let shiftX = event.clientX - seal1.getBoundingClientRect().left;
          let shiftY = event.clientY - seal1.getBoundingClientRect().top;

          seal1.style.position = 'absolute';
          seal1.style.zIndex = 1000;
          document.body.append(seal1);

          moveAt(event.pageX, event.pageY);

          function moveAt(pageX, pageY) {
            seal1.style.left = pageX - shiftX + 'px';
            seal1.style.top = pageY - shiftY + 'px';
          }

          function onMouseMove(event) {
            moveAt(event.pageX, event.pageY);

            seal1.hidden = true;
            let elemBelow = document.elementFromPoint(event.clientX, event.clientY);
            seal1.hidden = false;

            if (!elemBelow) return;

            let droppableBelow = elemBelow.closest('.droppable');
            if (currentDroppable != droppableBelow) {
              if (currentDroppable) { // null when we were not over a droppable before this event
                leaveDroppable(currentDroppable);
              }
              currentDroppable = droppableBelow;
              if (currentDroppable) { // null if we're not coming over a droppable now
                // (maybe just left the droppable)
                enterDroppable(currentDroppable);
              }
            }
          }

          document.addEventListener('mousemove', onMouseMove);

          seal1.onmouseup = function() {
            document.removeEventListener('mousemove', onMouseMove);
            seal1.onmouseup = null;
          };

        };
        function enterDroppable(elem) {
        elem.style.background = 'pink';
        }

        function leaveDroppable(elem) {
        elem.style.background = '';
        }

        seal1.ondragstart = function() {
        return false;
        };


    </script>
}
