    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<SealTypographic.Models.ImageData>
@{
    ViewBag.Title = "SelectSealCard";
}
<div class="container-fluid px-4">
                        <h1 class="mt-4">印鑑建檔</h1>
                        <ol class="breadcrumb mb-4">
                            <li class="breadcrumb-item active"></li>
                        </ol>
                        <div class="row">
                            <div class="col-xl-2">
                                <div class="card mb-2 h-50" >
                                    <div class="card-header">
                                        <i class="fas fa-chart-area me-1"></i>
                                        圖檔列表
                                    </div>
                                    <div class="card-body h-50">
                                            <div class="list-group overflow-auto h-100">
                                                @foreach (ImageData images in Model)
                                                {
                                                    <button type="button" class="list-group-item list" value="@images.FileName">@images.FileName</button>
                                                }
                                            </div>
                                    </div>
                                </div>
                                <div class="card mb-2">
                                    <div class="card-header">
                                        <i class="fas fa-chart-area me-1"></i>
                                        客戶類別
                                    </div>
                                    <div class="card-body">   
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="sealClassRadio" id="sealClassRadio1" value="CustomerSeal" checked>
                                            <label class="form-check-label" for="sealClassRadio1" value="CustomerSeal">客戶章</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="sealClassRadio" id="sealClassRadio2" value="AccountingSeal">
                                            <label class="form-check-label" for="sealClassRadio2" value="AccountingSeal">會計章</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="sealClassRadio" id="sealClassRadio3" value="LetterHead">
                                            <label class="form-check-label" for="sealClassRadio3" value="LetterHead">信頭紙</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="card mb-2">   
                                      <button id="next" type="submit" class="btn btn-primary float-right">下一步</button>
                                      <p>@ViewBag.imageName</p>
                                      <p>@ViewBag.sealsetClass</p>
                                </div>
                            </div>
                          <div class="col-xl-8">
                                <div class="card mb-8">
                                    <div class="card-header">
                                        <i class="fas fa-chart-bar me-1"></i>
                                        ImageView
                                    </div>
                                    <div id="sealcard" class="card-body">
                                        <img id="scanimage" src="img/NoImage.svg" class="img-fluid" alt="Responsive image" style="width: auto; height: auto;"/>
                                    </div>
                                </div>
                            </div>
                        </div>
</div>
 @section Scripts {
    <script>        
        $('.list-group-item').on('click', function() 
        {
            imageName = $(this);
            //var imagedata = imagename.data('alias');
            //Pass clicked link element to another function
            //console.log(imageName.text());  // Will log Paris | France | etc...
            //console.log(imagedata);  // Will output whatever is in data-alias=""
            
            //Change active 
            $('.active').removeClass('active');
            imageName.toggleClass('active');            
            //$("#scanimage").attr("src", '@Url.Action("GetScanImage", "CreateSealsSet")?imageName=' + imageName.val());                       
                        
            $.ajax({
                url: '@Url.Action("GetScanImage")',
                contentType: 'application/json; charset=utf-8',
                datatype: 'json',
                data: 
                {
                    imageName: imageName.val()
                },
                type: "GET",                
                success: function (Data) {                    
                    $("#scanimage").attr('src', Data);
                },
            });
        })
        

        $("#next").on('click', function() {

            var imageName = $('.list-group-item.active').val();
            var sealSetClass = $("input[name='sealClassRadio']:checked").val();            
            switch(sealSetClass) {
              case "CustomerSeal":
                window.location.href = "@Url.Action("CustomerSealset", "CreateSealsSet")?imageName="+ imageName;
                break;
              case "AccountingSeal":
                window.location.href = "@Url.Action("AccountingSealset", "CreateSealsSet")?imageName="+ imageName;
                break;
              case "LetterHead":
                window.location.href = "@Url.Action("LetterHeadSealset", "CreateSealsSet")?imageName="+ imageName;
                break;
              default:
                alert(sealSetClass);
                break;
            }
            
        })

    </script>
  }