@model IEnumerable<SealTypographic.Models.Seal>
@{
    ViewBag.Title = "Home Page";
}
<div class="container-fluid px-4">
                        <h1 class="mt-4">會計章</h1>
                        <ol class="breadcrumb mb-4">
                            <li class="breadcrumb-item active">印章貼上</li>
                        </ol>
                        <div class="row">
                            <div class="col-xl-2">
                                <div class="card mb-2" >
                                    <div class="card-header">
                                        <i class="fas fa-chart-area me-1"></i>
                                       章式列表
                                    </div>
                                    <div class="card-body overflow-scroll-40vh">
                                        <div class="list-group">
                                            @foreach (Seal seal in Model)
                                            {
                                                <button type="button" class="list-group-item list" value="@seal.SealImageName">@seal.SealImageName</button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-8">
                                <div class="card mb-8">
                                    <div class="card-header">
                                        <i class="fas fa-chart-area me-1"></i>
                                        顯示印鑑
                                    </div>
                                    <div class="card-body">
                                        <div class="card mb-2">
                                            <img id="sealImage" src="~/img/NoImage.svg" class="img-fluid" alt="Responsive image" style="width: 25%; height: 25%;" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
</div>
 @section Scripts {
    <script>
        $('.list-group-item').on('click', function() 
        {
            imageName = $(this);        
            //Change active 
            $('.active').removeClass('active');
            imageName.toggleClass('active');
            
            $.ajax({
                url: '/api/ImageGet/2/' + imageName.val(),
                //url: 'http://localhost:5008/ImageGet/2/' + imageName.val(),
                contentType: 'application/json; charset=utf-8',
                datatype: 'json',
                type: "GET",
                success: function (Data) {
                    $("#sealImage").attr('src', Data);
                },
            });
        })
    </script>
  }