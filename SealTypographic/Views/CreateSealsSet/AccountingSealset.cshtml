@model IEnumerable<SealTypographic.Models.Seal>
@{
    ViewBag.Title = "Home Page";
}
<div class="container-fluid px-4">
                        <h1 class="mt-4">會計章</h1>
                        <ol class="breadcrumb mb-4">
                            <li class="breadcrumb-item active">印章貼上</li>
                        </ol>
                        <div class="row">
                            <div class="col-xl-2">
                                <div class="card mb-2 h-50" >
                                    <div class="card-header">
                                        <i class="fas fa-chart-area me-1"></i>
                                       章式列表
                                    </div>
                                    <div class="card-body h-50">
                                        <div class="list-group overflow-auto h-100">
                                            @foreach (Seal seal in Model)
                                            {
                                                <button type="button" class="list-group-item list" value="@seal.SealImageName">@seal.SealImageName</button>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="card mb-2">   
                                      <img id="sealImage" src="img/NoImage.svg" class="img-fluid" alt="Responsive image" style="width: auto; height: auto;"/>
                                </div>
                            </div>
                            <div class="col-xl-8">
                                <div class="card mb-8">
                                    <div class="card-header">
                                        <i class="fas fa-chart-area me-1"></i>
                                        顯示指定掃描圖
                                    </div>
                                    <div class="card-body">
                                        <div id="sealcard" class="card-body">
                                            <img src="@Url.Action("GetScanImage", new{imageName = @ViewBag.imageName})"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
</div>
 @section Scripts {
    <script>
        $('.list-group-item').on('click', function() 
        {
            imageName = $(this);        
            //Change active 
            $('.active').removeClass('active');
            imageName.toggleClass('active');            
            $("#sealImage").attr("src", '@Url.Action("GetSealImage")?imageName=' + imageName.val());

        })
    </script>
  }