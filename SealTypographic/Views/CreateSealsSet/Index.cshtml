@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = "Index";
}                
    <div class="container-fluid px-4">
        <h1 class="mt-4">印鑑建檔</h1>
        <ol class="breadcrumb mb-4">
            <li class="breadcrumb-item active"></li>
        </ol>
        <div class="row">
            <div class="col-xl-2">
                    <div class="card mb-4">
                        <div class="card-header">
                            <i class="fas fa-chart-area me-1"></i>
                            掃描列表
                        </div>
                        <div class="card-body overflow-scroll-40vh">
                            <div class="list-group">
                            </div>
                        </div>
                    </div>
            </div>
            <div class="col-xl-8">
                <div class="card mb-4">
                    <div class="card-header">
                        <i class="fas fa-chart-bar me-1"></i>
                        掃圖結果
                    </div>
                    <div class="card-body">
                        <img id="scanImageView" src="~/img/NoImage.svg" class="img-fluid" alt="Responsive image" style="width: 25%; height: 25%;" />
                    </div>
                    <div id="uploadmessage" class="card-body">
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-xl-2">
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-xl-7">
                                <button type="button" id="scanOpen" class="btn btn-primary float-right">開啟掃描</button>
                            </div>
                            <div class="col-xl-5">
                                <button type="button" id="upLoad" class="btn btn-primary float-right">上傳</button>
                            </div>
                    </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2">
                <div class="card mb-4">
                    <div class="card-body">
                        <button id="next" type="submit" class="btn btn-primary float-right">下一步</button>
                    </div>
                </div>
            </div>            
        </div>
    </div>


<div class="modal fade dalert" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                連線失敗
            </div>
            <div class="modal-body">
                在您的電腦中找不到掃描應用程序，請先安裝並打開，然後刷新瀏覽器。
            </div>
        </div>
    </div>
</div>

@section Scripts
    {
    <script type="text/javascript">

        $(document).ready(function () {
            $("body").on("click", ".list-group-item", ListGroup);
        });        
        var start = function () {
            var i = 0;

            var wsImpl = window.WebSocket || window.MozWebSocket;
            
            window.ws = new wsImpl('ws://localhost:8181/');
            ws.onmessage = function (e) {
                if (typeof e.data === "string") {
                    //IF Received Data is String
                    //alert(e.data);                    

                    var ImageJSON = JSON.parse(e.data);
                                                    
                    $listgroup = $('<button>');                    
                    $listgroup.attr("type", "button");
                    $listgroup.attr("class", "list-group-item list");
                    $listgroup.attr("value", ImageJSON.Base64Data);
                    $listgroup.html(ImageJSON.ImageName);
                    $(".list-group").append($listgroup);                    
                }
                else if (e.data instanceof ArrayBuffer) {
                    //IF Received Data is ArrayBuffer
                }
                else if (e.data instanceof Blob) {

                }
            };
            ws.onopen = function () {
                //Do whatever u want when connected succesfully
            };
            ws.onclose = function () {
                $('.dalert').modal('show');
            };
        }
        window.onload = start;

        $('#scanOpen').on('click',function(){            
            ws.send(JSON.stringify({
                Opencode: '1100',
                ScanSavePath: 'C://temp//',
            }, null, '\t'));
            //$('.list-group').empty();
        });

        $("#next").on('click', function () {
            window.location.href = "@Url.Action("SelectSealCard", "CreateSealsSet")";
        });


        function ListGroup() 
        {
            imageName = $(this);
            var img = imageName.val();
            //console.log(img);
            //Change active
            $('.active').removeClass('active');
            imageName.toggleClass('active');

            $('#scanImageView').attr('src', imageName.val());
        }

        $("#upLoad").on('click', function(){
            var items = document.getElementsByClassName("list-group-item");            
            var imagedata = [];
            for (var i = 0; i < items.length; i++) {                
                var imageJson = {
                    FileName: items[i].textContent,
                    ImageBase64: items[i].value
                };
                imagedata.push(imageJson);
            }
            //console.log(JSON.stringify(imagedata));            
            $.ajax({
                url: '/api/upload/',
                type: "POST",                
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify(imagedata),             
                dataType: "json",                                                  
                success: function (result) {
                    alert(result);
                    $("#uploadmessage").html(result.message);
                }
            });
        })
    </script>
}