{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File"
            }
          ]
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": "1048576"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "AllowOrigins": [
    "*"
  ],
  "UploadPath": {
    "UploadRootPath": "C:/DJimage/SealTypographic/Upload/",
    "CustomerSealAuthorization": "CustomerSealAuthorization/",
    "AccountantSignAuthorization": "AccountantSignAuthorization/",
    "LetterheadImage": "LetterheadImage/",
    "PDF": "PDF/",
    "AccountantSignCertificate": "AccountantSignCertificate/",
    "Temporary": "Temporary/"
  },
  "SealPath": {
    "SealRootPath": "C:/DJImage/SealTypographic/SealImage/",
    "Customer": "Customer/",
    "Accountant": "Accountant/",
    "Letterhead": "Letterhead/",
    "ResizeScale": 0.3
  },
  "Provider": "Sqlite",
  "ConnectionStrings": {
    "Sqlite": "Data Source=./SealTypographic.db",
    "MySql": "server=127.0.0.1;port=3306;user=root;password=1qaz@WSX;database=sealtypographic;charset=utf8;"
  }
}