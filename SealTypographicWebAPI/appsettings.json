{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/log.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": "1048576"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
        }
      }
    ]
  },
    "AllowedHosts": "*",
    "AllowOrigins": [
      "*"
    ],
  "ScanConfigPath": {
    "ScanImagePath": "C:/DJimage/TestSealcard/",
    "CustomerFolder": "Customer/",
    "AccountantFolder": "Accountant/",
    "LetterheadFolder": "Letterhead/"
  },
  "SealPath": {
    "SealImagePath": "C:/DJImage/SealTypographic/SealImage/",
    "Costomer": "Customer/",
    "AccountantFolder": "Accountant/",
    "LetterheadFolder": "Letterhead/" 
  },
    "ConnectionStrings": {
      "Sqlite": "Data Source=./SealTypographic.db",
      "MySql": "server=127.0.0.1;port=3306;user=root;password=1qaz@WSX;database=sealTypographic;charset=utf8;"
    }
  }
