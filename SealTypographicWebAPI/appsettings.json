{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async",
      "Serilog.Sinks.MongoDB"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "./logs/log.txt",
                "rollingInterval": "Day",
                "rollOnFileSizeLimit": true,
                "fileSizeLimitBytes": "1048576",
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      },
      {
        "Name": "MongoDBBson",
        "Args": {
          "databaseUrl": "mongodb://localhost:27017/SealTypographic",
          "collectionName": "Log",
          "cappedMaxSizeMb": "2048",
          "cappedMaxDocuments": "100000",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "AllowOrigins": [
    "*"
  ],
  "SystemConfig": {
    "FinancialReportEnabled": true,
    "TaxReportEnabled": true
  },
  "UploadPath": {
    "UploadRootPath": "C:/DJimage/SealTypographic/Upload/",
    "CustomerSealAuthorization": "CustomerSealAuthorization/",
    "AccountantSignAuthorization": "AccountantSignAuthorization/",
    "LetterheadImage": "LetterheadImage/",
    "FinancialReport": "FinancialReport/",
    "TaxReport": "TaxReport/",
    "AccountantSignCertificate": "AccountantSignCertificate/",
    "Temporary": "Temporary/"
  },
  "SealPath": {
    "SealRootPath": "C:/DJImage/SealTypographic/SealImage/",
    "ResizeScale": 0.3
  },
  "TemplateImagePath": {
    "RootPath": "C:/DJImage/SealTypographic/TemplateImage/",
    "ResizeScale": 0.3
  },
  "TypographyEditImagePath": {
    "RootPath": "C:/DJImage/SealTypographic/TypographyEditImagePath/",
    "ResizeScale": 0.3
  },
  "Provider": "Sqlite",
  "ConnectionStrings": {
    "Sqlite": "Data Source=./SealTypographic.db",
    "MySql": "server=127.0.0.1;port=3306;user=root;password=1qaz@WSX;database=sealtypographic;charset=utf8;"
  },
  "KeycloakAdmin": {
    "BaseUrl": "https://djimage.myftp.org:53000/keycloak",
    "Realm": "djidentity",
    "AdminClientId": "admin-cli",
    "AdminClientSecret": "",
    "UserName": "admin",
    "Pwaosrsd": "1qaz@WSX",
    "ClientId": "sealTypographic",
    "CheckSslSkip": true
  },
  "Keycloak": {
    "realm": "djidentity",
    "AuthServerUrl": "https://djimage.myftp.org:53000/keycloak",
    //"auth-server-url": "https://djimage.myftp.org:53000/keycloak",
    "verify-token-audience": true,
    "ssl-required": "none",
    "resource": "sealTypographic",
    "credentials": {
      "secret": ""
    },
    "confidential-port": 0
  },
    "LogDatabase": {
      "ConnectionString": "mongodb://localhost:27017",
      "DataBaseName": "SealTypographic"
    }
  }