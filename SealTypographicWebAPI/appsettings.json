{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "./logs/log.txt",
                "rollingInterval": "Day",
                "rollOnFileSizeLimit": true,
                "fileSizeLimitBytes": "1048576"
              }
            }
          ]
        }
      },
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "AllowOrigins": [
    "*"
  ],
  "UploadPath": {
    "UploadRootPath": "C:/DJimage/SealTypographic/Upload/",
    "CustomerSealAuthorization": "CustomerSealAuthorization/",
    "AccountantSignAuthorization": "AccountantSignAuthorization/",
    "LetterheadImage": "LetterheadImage/",
    "PDF": "PDF/",
    "AccountantSignCertificate": "AccountantSignCertificate/",
    "Temporary": "Temporary/"
  },
  "SealPath": {
    "SealRootPath": "C:/DJImage/SealTypographic/SealImage/",
    "ResizeScale": 0.3
  },
  "TemplateImagePath": {
    "RootPath": "C:/DJImage/SealTypographic/TemplateImage/",
    "ResizeScale": 0.3
  },
  "Provider": "Sqlite",
  "ConnectionStrings": {
    "Sqlite": "Data Source=./SealTypographic.db",
    "MySql": "server=127.0.0.1;port=3306;user=root;password=1qaz@WSX;database=sealtypographic;charset=utf8;"
  },
  "KeycloakAdmin": {
    "Realm": "djidentity",
    "BaseUrl": "http://djimage.myftp.org:50500/",
    "ClientId": "admin-cli",
    "ClientSecret": "",
    "UserName": "admin",
    "Pwaosrsd": "1qaz@WSX",
    "ResourceId": "79c9ec63-c06a-4386-888a-1e7b71478f05"
  },
  "Keycloak": {
    "realm": "djidentity",
    "auth-server-url": "http://djimage.myftp.org:50500/",
    "ssl-required": "none",
    "resource": "sealTypographic",
    "public-client": true,
    "confidential-port": 0
  }
}