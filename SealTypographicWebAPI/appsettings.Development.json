{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async",
      "Serilog.Sinks.MongoDB"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "./logs/log.txt",
                "rollingInterval": "Day",
                "rollOnFileSizeLimit": true,
                "fileSizeLimitBytes": "1048576",
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      },
      {
        "Name": "MongoDBBson",
        "Args": {
          "databaseUrl": "mongodb://localhost:27017/SealTypographic",
          "collectionName": "Log",
          "cappedMaxSizeMb": "1024",
          "cappedMaxDocuments": "50000",
          "rollingInterval": "Month"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "AllowOrigins": [
    "*"
  ],
  "KeycloakAdmin": {
    "BaseUrl": "https://djimage.myftp.org:53000/keycloak",
    "Realm": "djidentity",
    "AdminClientId": "admin-cli",
    "AdminClientSecret": "",
    "UserName": "admin",
    "Pwaosrsd": "1qaz@WSX",
    "ClientId": "sealTypographic",
    "CheckSslSkip": true
  },
  "Keycloak": {
    "realm": "djidentity",
    "auth-server-url": "https://djimage.myftp.org:53000/keycloak",
    "verify-token-audience": true,
    "ssl-required": "none",
    "resource": "sealTypographic",
    "credentials": {
      "secret": ""
    },
    "confidential-port": 0
  },
  "Provider": "Sqlite",
  "ConnectionStrings": {
    "Sqlite": "Data Source=./SealTypographic.db",
    "MySql": "server=127.0.0.1;port=3306;user=root;password=1qaz@WSX;database=sealtypographic;charset=utf8;",
    "PostgreSQL": "Host=localhost;Port=5432;Database=sealtypographic;Username=postgres;Password=1qaz@WSX;"
  },
  "LogDatabase": {
    "ConnectionString": "mongodb://localhost:27017",
    "DataBaseName": "SealTypographic"
  }
}