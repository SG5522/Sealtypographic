{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Error"
      }
    }
  },
  "AllowedHosts": "*",
  "AllowOrigins": [
    "*"
  ],
  "Jwt": {
    "MetadataAddress": "http://djimage.myftp.org:50500/realms/djidentity/.well-known/openid-configuration",
    "Authority": "http://djimage.myftp.org:50500/realms/djidentity",
    "Audience": "webapi"
  },
  "Keycloak": {
    "realm": "sealtypographic",
    "auth-server-url": "http://djimage.myftp.org:50500/",
    "ssl-required": "none",
    "resource": "webapi",
    "public-client": true,
    "confidential-port": 0
  }
}