<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
	<Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <DocumentationFile></DocumentationFile>
    <IncrementVersionOnBuild>0.0.3.1+</IncrementVersionOnBuild>
    <Version>0.0.3.1707</Version>
    <PackageIcon>android-chrome-128x128.png</PackageIcon>
    <Configurations>Debug;Release</Configurations>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>    
	  
  </PropertyGroup>

	<ItemGroup>
    <Compile Remove="logs\**" />
    <Content Remove="logs\**" />
    <EmbeddedResource Remove="logs\**" />
    <None Remove="logs\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\SealTypographicWebAPI\wwwroot\swagger\android-chrome-128x128.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.UI" Version="7.0.2" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.InMemory.Storage" Version="7.0.0" />
    <PackageReference Include="AutoMapper" Version="13.0.1" />
    <PackageReference Include="DJCommonLib" Version="6.0.12" />
    <PackageReference Include="DJImageLib" Version="6.0.9" />
    <PackageReference Include="DJKeycloakAPI" Version="6.0.17" CopyDirectory="lib\net6.0\**\*.*" />
    <PackageReference Include="DJKeycloakLib" Version="6.0.10" CopyDirectory="lib\net6.0\**\*.*" />	  
    <PackageReference Include="Keycloak.AuthServices.Authentication" Version="1.6.0" />
    <PackageReference Include="Keycloak.AuthServices.Authorization" Version="1.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Certificate" Version="6.0.31" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="6.0.31" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="6.0.30" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="7.0.20">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <PackageReference Include="MongoDB.Driver" Version="2.25.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.1" />
    <PackageReference Include="Serilog.Expressions" Version="4.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="2.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="1.5.0" />
    <PackageReference Include="Serilog.Sinks.MongoDB" Version="5.4.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DBEntities\DBEntities.csproj" />
    <ProjectReference Include="..\DJSpire\DJSpire.csproj" />
    <ProjectReference Include="..\MySqlMigrations\MySql.csproj" />
    <ProjectReference Include="..\SqliteMigrations\Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Sit.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

    <Target Name="CopyOtherForBuild" AfterTargets="Build">
	    <ItemGroup>
		    <PackageCopyFiles Condition="%(PackageReference.CopyDirectory) != ''" Include="$(NugetPackageRoot)\%(PackageReference.FileName)\%(PackageReference.Version)\%(PackageReference.CopyDirectory)" />
		    <PackageContentFiles Condition="%(PackageReference.CopyContentFiles) != ''" Include="$(NugetPackageRoot)\%(PackageReference.FileName)\%(PackageReference.Version)\%(PackageReference.CopyContentFiles)" />
	    </ItemGroup>
	    <Copy SourceFiles="@(PackageCopyFiles)" DestinationFolder="$(OutDir)\%(RecursiveDir)" />
	    <Copy SourceFiles="@(PackageContentFiles)" DestinationFolder="$(OutDir)\%(RecursiveDir)" />
    </Target>

    <Target Name="CopyOtherForPublish" BeforeTargets="Publish">
	    <ItemGroup>
		    <PackageCopyFiles Condition="%(PackageReference.CopyDirectory) != ''" Include="$(NugetPackageRoot)\%(PackageReference.FileName)\%(PackageReference.Version)\%(PackageReference.CopyDirectory)" />
		    <PackageContentFiles Condition="%(PackageReference.CopyContentFiles) != ''" Include="$(NugetPackageRoot)\%(PackageReference.FileName)\%(PackageReference.Version)\%(PackageReference.CopyContentFiles)" />
	    </ItemGroup>
	    <Copy SourceFiles="@(PackageCopyFiles)" DestinationFolder="$(PublishDir)\%(RecursiveDir)" />
	    <Copy SourceFiles="@(PackageContentFiles)" DestinationFolder="$(PublishDir)\%(RecursiveDir)" />
    </Target>
	
</Project>
