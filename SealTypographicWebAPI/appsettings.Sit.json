{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.MongoDB"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "MongoDBBson",
        "Args": {
          "databaseUrl": "mongodb://localhost:27017/SealTypographic",
          "collectionName": "Log",
          "cappedMaxSizeMb": "2048",
          "cappedMaxDocuments": "100000",
          "rollingInterval": "Month"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "AllowOrigins": [
    "*"
  ],
  "UploadPath": {
    "UploadRootPath": "C:/DJimage/SealTypographicSit/Upload/"
  },
  "SealPath": {
    "SealRootPath": "C:/DJImage/SealTypographicSit/SealImage/"
  },
  "TemplateImagePath": {
    "RootPath": "C:/DJImage/SealTypographicSit/TemplateImage/"
  },
  "KeycloakAdmin": {
    "BaseUrl": "https://djimage.myftp.org:53000/keycloak",
    "Realm": "djidentity",
    "AdminClientId": "admin-cli",
    "AdminClientSecret": "",
    "UserName": "admin",
    "Pwaosrsd": "1qaz@WSX",
    "ClientId": "sealTypographic",
    "CheckSslSkip": true
  },
  "Keycloak": {
    "realm": "djidentity",
    "auth-server-url": "https://djimage.myftp.org:53000/keycloak",
    "verify-token-audience": true,
    "ssl-required": "none",
    "resource": "sealTypographic",
    "credentials": {
      "secret": ""
    },
    "confidential-port": 0
  },
  "Provider": "PostgreSQL",
  "ConnectionStrings": {
    "Sqlite": "Data Source=./SealTypographic.db",
    "MySql": "server=127.0.0.1;port=3306;user=root;password=1qaz@WSX;database=sealtypographic;charset=utf8;",
    "PostgreSQL": "Host=localhost;Port=5432;Database=sealtypographic;Username=postgres;Password=1qaz@WSX;"
  },
  "LogDatabase": {
    "ConnectionString": "mongodb://localhost:27017",
    "DataBaseName": "SealTypographic"
  }
}