    "auth-server-url": "http://djimage.myftp.org:50500/",
    "ssl-required": "none",
    "resource": "webapi",
    "public-client": true,
    "confidential-port": 0
  },
  "UploadPath": {
    "UploadRootPath": "C:/DJimage/Sit/SealTypographic/Upload/"
  },
  "SealPath": {
    "SealRootPath": "C:/DJImage/Sit/SealTypographic/SealImage/"
  },
  "TemplateImagePath": {
    "RootPath": "C:/DJImage/Sit/SealTypographic/TemplateImage/"
  }
}