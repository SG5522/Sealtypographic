{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Error"
      }
    }
  },
  "AllowedHosts": "*",
  "AllowOrigins": [
    "*"
  ],
  "SystemConfig": {
    "FinancialReportEnabled": false,
    "TaxReportEnabled": true
  },
  "UploadPath": {
    "UploadRootPath": "C:/DJimage/UAT/SealTypographic/Upload/"
  },
  "SealPath": {
    "SealRootPath": "C:/DJImage/UAT/SealTypographic/SealImage/"
  },
  "TemplateImagePath": {
    "RootPath": "C:/DJImage/UAT/SealTypographic/TemplateImage/"
  }
}